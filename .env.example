# PostgreSQL application foundation (PLATFORM-BASELINE-001).
# Copy relevant lines into a local, git-ignored .env file — never commit
# real credentials. See functions/src/infrastructure/postgres/postgresConfig.ts
# for full validation/fail-closed behaviour.

# Required. One of: local | test | production. No default — an unset value
# fails closed rather than silently behaving as "local".
PLATFORM_ENV=local

# Required when PLATFORM_ENV=production. Optional in local/test, where a
# documented default pointing at the disposable docker-compose.postgres.yml
# instance is used instead. Never defaults to a shared/live database.
# PLATFORM_POSTGRES_URL=postgres://postgres:postgres@localhost:54329/eleventhonus_platform_local

# Optional. Exactly "true" or "false" (lowercase). Defaults to true in
# production, false in local/test. An explicit value that is anything else
# (e.g. "TRUE" or "treu") is rejected — SSL is never silently weakened.
# PLATFORM_POSTGRES_SSL=false

# Optional connection-pool tuning (see postgresPool.ts for rationale).
# PLATFORM_POSTGRES_POOL_MAX=3
# PLATFORM_POSTGRES_IDLE_TIMEOUT_MS=10000
# PLATFORM_POSTGRES_CONNECTION_TIMEOUT_MS=5000
