{
  "name": "11thonus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "playwright test --project=chromium --project=chromium-dashboard-harness",
    "test:e2e:preview": "playwright test --project=chromium-preview --project=chromium-preview-mobile",
    "test:e2e:emulator": "node tests/e2e/emulator/seedCommerceKnowledge.mjs && playwright test --project=chromium-emulator-e2e",
    "emulators": "firebase emulators:start --project demo-11thonus",
    "emulators:clean": "pnpm --filter functions run build && firebase emulators:start --project demo-11thonus",
    "emulators:validate": "firebase emulators:exec --project demo-11thonus \"pnpm --filter functions test:emulator\"",
    "postgres:up": "docker compose -f docker-compose.postgres.yml up -d --wait",
    "postgres:down": "docker compose -f docker-compose.postgres.yml down -v",
    "test:postgres": "pnpm postgres:up && PLATFORM_ENV=test pnpm --filter functions test:postgres",
    "seed:test-only-terms-fixture": "node tests/e2e/emulator/seedTestOnlyTermsFixture.mjs",
    "preview:start": "node tests/preview/cli.mjs start",
    "preview:stop": "node tests/preview/cli.mjs stop",
    "preview:status": "node tests/preview/cli.mjs status",
    "preview:reset": "node tests/preview/cli.mjs reset",
    "preview:seed": "node tests/preview/cli.mjs seed",
    "preview:migrate": "node tests/preview/cli.mjs migrate",
    "preview:verify": "node tests/preview/cli.mjs verify",
    "preview:accounts": "node tests/preview/cli.mjs accounts",
    "test:preview-tooling": "node --test tests/preview/guards.test.mjs tests/preview/ports.test.mjs tests/preview/phone/policy.test.mjs tests/preview/phone/proxy.test.mjs tests/preview/phone/verify.test.mjs tests/preview/phone/ownership.test.mjs tests/preview/phone/tunnel.test.mjs tests/preview/phone/build.test.mjs tests/preview/phone/build.integration.test.mjs",
    "prepare": "husky",
    "preview:counter-checks": "node tests/preview/cli.mjs counter-checks",
    "preview:phone": "node tests/preview/phone/cli.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-tools": "^15.24.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.64.0"
  },
  "packageManager": "pnpm@9.15.9",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": [
      "prettier --write"
    ]
  }
}
