# Placeholder keys only — no real values. Copy to apps/web/.env.local and
# fill in per environment (never commit .env.local — it is gitignored).
#
#   cp apps/web/.env.example apps/web/.env.local
#
# This is the canonical environment example for apps/web. It must live here,
# not at the repository root: Vite's env loading defaults to the working
# directory the dev/build command actually runs from (apps/web/, since pnpm
# scripts run with cwd set to the package directory), not the monorepo root
# — a root-level .env.local would never be read. See
# apps/web/src/config/env.ts for how these are loaded and validated.

# Frontend backend-provider selector (see ENG-P0-001/002 scaffold).
VITE_BACKEND_PROVIDER=firebase

# Firebase client SDK configuration — from the Firebase console's project
# settings for the target project (europe-west1, DEC-TECH-005). Required.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional.
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: force emulator connection on/off. Defaults to Vite's DEV flag
# (true in `vite dev`, false in a production build) when unset.
VITE_USE_FIREBASE_EMULATOR=

# Optional: App Check (ENG-P1-001). Unset until a europe-west1 Firebase
# project issues a real reCAPTCHA site key. In development this leaves App
# Check inactive with a console warning; outside development, initialization
# now fails closed (throws) rather than booting unprotected — see
# apps/web/src/infrastructure/firebase/appCheck.ts.
VITE_APP_CHECK_SITE_KEY=
VITE_APP_CHECK_DEBUG_TOKEN=

# Optional: frontend observability foundation (ENG-P1-003-IMP-01/02/03,
# DEC-PROV-005 Option C). Defaults to disabled/no-op when unset. Safe to
# leave every line below blank — the application runs correctly with no
# observability configuration at all. See apps/web/src/observability/
# config.ts and providerSelection.ts for the exact activation logic.
#
# VITE_OBSERVABILITY_ENABLED: "true" or "false" (default false).
# VITE_OBSERVABILITY_PROVIDER: "noop" (default) or "sentry". Activating
#   Sentry additionally requires VITE_OBSERVABILITY_ENABLED=true *and* a
#   non-empty VITE_OBSERVABILITY_DSN below — any one missing silently
#   falls back to the no-op provider, never an error.
# VITE_OBSERVABILITY_RELEASE: optional free-text release identifier.
VITE_OBSERVABILITY_ENABLED=
VITE_OBSERVABILITY_PROVIDER=
VITE_OBSERVABILITY_RELEASE=

# CR3 (EXT-TECH-001-HARNESS-CR3): activates the dedicated hosted
# test-harness build (`harness.html` / `vite build --mode test-harness`
# only — never read by `vite dev` or an ordinary `vite build`). Must be
# exactly "true"; combined at build time with the Vite mode and the
# resolved Firebase project ID (see testHarnessGate.ts) — any one wrong
# or missing fails closed. Leave unset everywhere else, including CI.
VITE_ENABLE_PHONE_AUTH_TEST_HARNESS=

# VITE_OBSERVABILITY_DSN (ENG-P1-003-IMP-03): a Sentry DSN is a public,
# client-embeddable identifier by Sentry's own design — not a secret —
# but this repository still ships with it blank: creating a Sentry
# organisation/project and issuing a real DSN is a Founder-controlled
# external action this task does not perform. Leave blank for local
# development and in CI. A future environment (e.g. staging) that
# activates Sentry would set this to that project's real DSN — never
# commit a real value to this example file.
VITE_OBSERVABILITY_DSN=
