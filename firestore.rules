rules_version = '2';

// Deny-by-default foundation (TRD12 §12.17-12.18; Version 1 Engineering Blueprint §4.3).
// Domain-specific rules are Phase 1+ work (ENG-P1-xxx).
service cloud.firestore {
  match /databases/{database}/documents {
    // Customer Identity persistence (ENG-P2-001-05).
    //
    // All four collections below are written exclusively through trusted
    // server-side paths (Cloud Functions using the Admin SDK, which is not
    // subject to Security Rules at all). These `match` blocks therefore
    // exist to make the deny-all posture explicit and collection-scoped
    // for DIRECT CLIENT access — not to grant any access.
    //
    // No direct customer read is granted here. Every currently-implemented
    // consumer of this data is a trusted server path; no customer-facing
    // profile UI, merchant lookup UI, or QR scanner exists yet in this
    // codebase (all deferred, ENG-P2-001-05 implementation report §"Deferred
    // Items"). Granting broad read access now — merely because a future UI
    // will eventually need *some* narrow, still-undetermined read shape —
    // would be inventing that shape ahead of the task that actually defines
    // it. When that task lands, it adds its own narrowly-scoped `allow read`
    // condition here; it does not loosen this default.
    match /users/{customerIdentityId} {
      allow read, write: if false;
    }

    match /customerProfiles/{customerIdentityId} {
      allow read, write: if false;
    }

    // Document ID is the Loyalty Number value itself — global uniqueness is
    // enforced by this doc-ID-as-value pattern, not by a rule.
    match /loyaltyNumbers/{loyaltyNumberValue} {
      allow read, write: if false;
    }

    // Document ID is the QR reference value itself. Client code must never
    // be able to enumerate, create, or flip a record's status (active vs
    // invalidated) directly — QR issuance/regeneration is a trusted
    // server-side transaction, never a direct client write.
    match /qrIdentityRecords/{qrReference} {
      allow read, write: if false;
    }

    // Platform Administration — Knowledge Studio authorization foundation
    // (ENG-P3-003A, ENG-P3-003-DESIGN-001 §6/§10, FD-KS-1/DEC-GOV-011).
    //
    // Written exclusively through trusted server-side paths (the Admin SDK,
    // not subject to Security Rules) — `bootstrapPlatformAdministrator.ts`
    // (never wired to any client-reachable transport) and, in a future
    // package, governed callables. No client — including an active platform
    // administrator's own signed-in session — ever creates, activates,
    // suspends, removes, or changes permissions on a `platformAdministrators`
    // record directly; that would make administrator management a
    // client-self-service operation, which `ENG-P3-003-DESIGN-001` and this
    // task's own security requirements explicitly forbid. These blocks make
    // that deny-all posture explicit for these two new collections, not to
    // grant any access.
    match /platformAdministrators/{userId} {
      allow read, write: if false;
    }

    // Append-only audit trail for Platform Administration authorization
    // decisions and administrator lifecycle events (ENG-P3-003A). No client
    // ever reads or writes this collection directly — a future, separately
    // authorized administrative audit-search surface would add its own
    // narrowly-scoped `allow read` here; it does not loosen this default.
    match /platformAdministrationAuditRecords/{recordId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
