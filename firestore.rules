rules_version = '2';

// Deny-by-default foundation (TRD12 §12.17-12.18; Version 1 Engineering Blueprint §4.3).
// Domain-specific rules are Phase 1+ work (ENG-P1-xxx) — this placeholder intentionally
// grants no access so the emulator has a defined, safe starting posture.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
